[Unit]
Description=Reads the windspeed via modbus
After=network.target
StartLimitIntervalSec=3600
StartLimitAction=reboot

[Service]
Type=simple
EnvironmentFile=/etc/solarinvert/influxdb.env
EnvironmentFile=/etc/solarinvert/wind_modbus.env
ExecStart=/usr/bin/log_solarinvert_wind_modbus.sh "${UART}" "${MEASUREMENT_DURATION_SECONDS}" "${INFLUX_ENDPOINT}" "${INFLUX_ORG}" "${INFLUX_BUCKET}" "${INFLUX_HASH}"
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
